# Bring Your Own Models (BYOK) — all keys are user-supplied, git-ignored.
# Copy to .env and fill in only what you use. Tests run mocked without any key.

# Cloud embeddings / LLMs (pick any you have keys for)
NVIDIA_API_KEY=nvapi-...
GROQ_API_KEY=gsk_...

# Optional: LangChain tracing (LangSmith) — no data leaves your machine without it
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=

# Legacy SaaS-era settings (no longer required by the sidecar; kept for reference)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
